<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Package versioned guidance for explicit, consumer-approved AgentDocs installation. -->
  <ItemGroup Condition="'$(TrellisApiRefName)' != ''">
    <PackageGuidanceItem
        Include="$(MSBuildThisFileDirectory)docs\docfx_project\api_reference\trellis-api-$(TrellisApiRefName).md"
        PackagePath="trellis-api-$(TrellisApiRefName).md"
        Usage="onDemand"
        Description="$(TrellisApiRefDescription)" />
    <PackageGuidanceReference Include="upstream/trellis-api-authorization.md"
                              PackageId="Trellis.Core"
                              DocumentPath="trellis/trellis-api-authorization.md" />
    <PackageGuidanceReference Include="upstream/trellis-api-asp.md"
                              PackageId="Trellis.Core"
                              DocumentPath="trellis/trellis-api-asp.md" />
  </ItemGroup>

  <ItemGroup Condition="'$(TrellisApiRefName)' != '' AND '$(TrellisApiRefName)' != 'microservices-abstractions'">
    <PackageGuidanceReference Include="trellis-api-microservices-abstractions.md"
                              PackageId="Trellis.Microservices.Abstractions"
                              DocumentPath="trellis-api-microservices-abstractions.md" />
    <PackageGuidanceReference Include="trellis-api-microservices-cookbook.md"
                              PackageId="Trellis.Microservices.Abstractions"
                              DocumentPath="trellis-api-microservices-cookbook.md" />
  </ItemGroup>

  <ItemGroup Condition="'$(TrellisApiRefName)' != '' AND '$(TrellisApiRefName)' != 'yarp'">
    <PackageGuidanceReference Include="trellis-api-yarp.md"
                              PackageId="Trellis.Yarp"
                              DocumentPath="trellis-api-yarp.md" />
  </ItemGroup>

  <ItemGroup Condition="'$(TrellisApiRefName)' != '' AND '$(TrellisApiRefName)' != 'internal-jwt'">
    <PackageGuidanceReference Include="trellis-api-internal-jwt.md"
                              PackageId="Trellis.Microservices.AspNetCore"
                              DocumentPath="trellis-api-internal-jwt.md" />
  </ItemGroup>

  <!-- The foundational Abstractions package also carries the cross-package cookbook. -->
  <ItemGroup Condition="'$(TrellisShipsCookbook)' == 'true'">
    <PackageGuidanceItem
        Include="$(MSBuildThisFileDirectory)docs\docfx_project\api_reference\trellis-api-microservices-cookbook.md"
        PackagePath="trellis-api-microservices-cookbook.md"
        Usage="onDemand"
        Description="$(TrellisCookbookDescription)" />
    <PackageGuidanceReference Include="upstream/trellis-api-core.md"
                              PackageId="Trellis.Core"
                              DocumentPath="trellis/trellis-api-core.md" />
    <PackageGuidanceReference Include="upstream/trellis-api-servicedefaults.md"
                              PackageId="Trellis.Core"
                              DocumentPath="trellis/trellis-api-servicedefaults.md" />
    <PackageGuidanceReference Include="upstream/trellis-api-cookbook.md"
                              PackageId="Trellis.Core"
                              DocumentPath="trellis/trellis-api-cookbook.md" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)build\Trellis.Guidance.Links.targets"
          Condition="'$(TrellisApiRefName)' != ''" />

  <Target Name="LintApiReference"
          BeforeTargets="Build"
          Condition="'$(TrellisEnableApiReferenceLint)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingForLiveUnitTesting)' != 'true'">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)docs/lint-api-reference.ps1&quot;" />
  </Target>
</Project>
