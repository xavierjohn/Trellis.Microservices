{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information",
      "Trellis": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "orders-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "billing-route": {
        "ClusterId": "billing",
        "Match": { "Path": "/api/billing/{**catch-all}" }
      }
    },
    "Clusters": {
      "orders": {
        "Destinations": {
          "orders/destination1": {
            "Address": "https+http://orders"
          }
        }
      },
      "billing": {
        "Destinations": {
          "billing/destination1": {
            "Address": "https+http://billing"
          }
        }
      }
    }
  }
}
